<?xml version="1.0" encoding="utf-8"?>
<!-- Layout principal con interfaz basica para probar los 8 ejercicios de la guia SENA -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:text="Servicios y notificaciones"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Ejercicio 1 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ejercicio 1: Servicio Contador"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnEjercicio1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejecutar ServicioContador" />

        <!-- Ejercicio 2 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ejercicio 2: Factorial mediante Intent (numero = 5)"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnEjercicio2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enviar 5 a ServicioOperacion" />

        <!-- Ejercicio 3 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ejercicio 3: Simular Descarga"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnEjercicio3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejecutar ServicioDescarga" />

        <!-- Ejercicio 4 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ejercicio 4: Calcular Cuadrado"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etNumeroEjercicio4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese un numero"
            android:inputType="numberDecimal" />

        <Button
            android:id="@+id/btnEjercicio4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enviar Numero para Cuadrado" />

        <!-- Ejercicio 5 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ejercicio 5: Notificacion con Acciones"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnEjercicio5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crear Notificacion con Botones" />

        <!-- Ejercicio 6 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ejercicio 6: Notificacion Imagen Grande"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnEjercicio6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mostrar Notificacion BigPictureStyle" />

        <!-- Ejercicio 7 y 8 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ejercicios 7 y 8: Broadcast Receivers"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Los receptores para estado de cargador y modo avion estan registrados en el sistema. Puedes probarlos conectando/desconectando el cargador o activando/desactivando el modo avion en el dispositivo o emulador."
            android:textSize="13sp"
            android:textColor="#555555" />

    </LinearLayout>
</ScrollView>
